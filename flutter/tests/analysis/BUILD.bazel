load("//flutter:android_toolchain.bzl", "android_toolchain")
load("//flutter:defs.bzl", "flutter_app", "flutter_library")
load("//flutter:linux_toolchain.bzl", "linux_toolchain")
load(
    ":defs_analysis_test.bzl",
    "android_offline_test",
    "android_online_test",
    "android_toolchain_roots_test",
    "build_command_test",
    "embed_guard_test",
)

android_toolchain(
    name = "fixture_android",
    build_tools_version = "35.0.0",
    gradle = "gradle-fixture.zip",
    gradle_version = "8.7",
    sdk = "@bazel_skylib//:LICENSE",
    sdk_version = "35",
)

# The SDK comes from an external repo (workspace_root branch) and the Gradle
# distribution from the main repo (single-directory branch), so one test
# covers both root-derivation paths.
android_toolchain_roots_test(
    name = "android_toolchain_roots_test",
    expected_gradle_home = "flutter/tests/analysis",
    expected_sdk_path = "external/bazel_skylib+",
    target_under_test = ":fixture_android",
)

toolchain(
    name = "fixture_android_toolchain",
    toolchain = ":fixture_android",
    toolchain_type = "//flutter:android_toolchain_type",
)

linux_toolchain(
    name = "fixture_linux",
    debian_arch = "amd64",
    flutter_arch = "x64",
    gnu_triple = "x86_64-linux-gnu",
    loader = "lib64/ld-linux-x86-64.so.2",
    packages = "linux-toolchain-fixture.txt",
)

toolchain(
    name = "fixture_linux_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":fixture_linux",
    toolchain_type = "//flutter:linux_toolchain_type",
)

# Fixture targets are analysis-only: the analysis tests inspect their action
# graphs without executing them. Tagged manual so wildcard builds skip them.
flutter_library(
    name = "fixture_lib",
    srcs = ["lib/main.dart"],
    pubspec = "pubspec.yaml",
    tags = ["manual"],
)

flutter_app(
    name = "fixture_app",
    build_args = ["--no-tree-shake-icons"],
    dart_defines = {"COMMON_DEFINE": "common-value"},
    embed = [":fixture_lib"],
    tags = ["manual"],
    web = {
        "srcs": [],
        "build_args": ["--source-maps"],
        "dart_defines": {"WEB_DEFINE": "web value with spaces"},
        "mode": "profile",
    },
)

flutter_app(
    name = "fixture_default_app",
    embed = [":fixture_lib"],
    tags = ["manual"],
    web = [],
)

build_command_test(
    name = "build_command_customization_test",
    absent_substrings = ["--release"],
    expected_substrings = [
        "'--profile'",
        "'--dart-define=COMMON_DEFINE=common-value'",
        "'--dart-define=WEB_DEFINE=web value with spaces'",
        "'--no-tree-shake-icons' '--source-maps'",
    ],
    target_under_test = ":fixture_app.web",
)

build_command_test(
    name = "build_command_defaults_test",
    absent_substrings = [
        "--dart-define",
        "--profile",
        "exec > >(tee",
    ],
    expected_inputs = ["flutter/private/tools/web_normalizer.dart"],
    expected_substrings = [
        "'build' 'web' '--no-pub' '--release'",
        "Status: Success",
    ],
    ordered_substrings = [
        '"$DART_BIN_LOCAL" "$WEB_NORMALIZER_ABS"',
        "# Copy build artifacts to absolute path",
    ],
    target_under_test = ":fixture_default_app.web",
)

flutter_app(
    name = "fixture_linux_app",
    embed = [":fixture_lib"],
    linux = [],
    tags = ["manual"],
)

build_command_test(
    name = "linux_hermetic_toolchain_test",
    absent_substrings = [
        "command -v clang",
        "command -v cmake",
        "command -v ninja",
        "command -v pkg-config",
        "_linux_compiler_wrapper()",
        "--set-interpreter",
        "-DCMAKE_BUILD_WITH_INSTALL_RPATH=ON",
    ],
    expected_inputs = [
        "flutter/private/linux_cmake_initial_cache.cmake",
        "flutter/private/linux_tool_launcher.sh",
        "flutter/private/linux_toolchain_setup.sh",
        "flutter/tests/analysis/linux-toolchain-fixture.txt",
    ],
    expected_substrings = [
        "LINUX_ROOT=",
        "LINUX_LOADER=",
        "LINUX_TOOL_LAUNCHER=",
        "LINUX_CMAKE_INITIAL_CACHE=",
        "source \"$ORIGINAL_PWD/",
        "'build' 'linux' '--no-pub' '--release'",
        "build/linux/x64/release/bundle",
    ],
    target_under_test = ":fixture_linux_app.linux",
)

flutter_app(
    name = "fixture_android_test_app",
    apk = {
        "srcs": [],
        "mode": "debug",
        "android_test": True,
        "android_maven_repo": "@bazel_skylib//:LICENSE",
    },
    embed = [":fixture_lib"],
    tags = ["manual"],
)

flutter_app(
    name = "fixture_android_app",
    apk = {
        "srcs": [],
        "android_maven_repo": "@bazel_skylib//:LICENSE",
    },
    embed = [":fixture_lib"],
    tags = ["manual"],
)

build_command_test(
    name = "android_test_apk_test",
    expected_substrings = [
        "'build' 'apk' '--no-pub' '--debug'",
        "app:assembleAndroidTest",
        "androidTest",
    ],
    target_under_test = ":fixture_android_test_app.apk",
)

build_command_test(
    name = "android_default_apk_test",
    absent_inputs = ["flutter/private/tools/web_normalizer.dart"],
    absent_substrings = ["assembleAndroidTest"],
    expected_substrings = [
        "'build' 'apk' '--no-pub' '--release'",
    ],
    target_under_test = ":fixture_android_app.apk",
)

# The fixture uses analysis-only Maven and toolchain stand-ins; the tests read
# the action graph without executing it.
flutter_app(
    name = "fixture_android_offline_app",
    apk = {
        "srcs": [],
        "mode": "debug",
        "android_maven_repo": "@bazel_skylib//:LICENSE",
    },
    embed = [":fixture_lib"],
    tags = ["manual"],
)

# With the closure declared and offline resolution on, the action has nothing
# left to fetch -- so requires-network goes. Everything else stays: the Android
# SDK is still a path reference to a host install, which is what no-sandbox and
# no-remote-cache are actually about.
# (The execution requirements themselves are asserted directly in
# //flutter/tests:exec_posture_test -- analysistest's Action exposes argv,
# inputs and env, but not execution_requirements.)
android_offline_test(
    name = "android_offline_apk_test",
    expected_inputs = [
        "android.init.gradle.kts",
        "gradle-fixture.zip",
    ],
    expected_substrings = [
        "RULES_FLUTTER_MAVEN_MIRROR",
        "GRADLE_USER_HOME/init.d",
        "ANDROID_USER_HOME",
    ],
    target_under_test = ":fixture_android_offline_app.apk",
)

android_online_test(
    name = "android_online_apk_test",
    expected_substrings = [
        "RULES_FLUTTER_MAVEN_MIRROR",
        "GRADLE_USER_HOME/init.d",
    ],
    target_under_test = ":fixture_android_offline_app.apk",
)

# Mirrors a generated package repository target: its cache holds only its
# own payload, so embedding it must be rejected at analysis time.
flutter_library(
    name = "fixture_unassembled_lib",
    srcs = ["lib/main.dart"],
    assemble_dep_caches = False,
    pubspec = "pubspec.yaml",
    tags = ["manual"],
)

flutter_app(
    name = "fixture_unassembled_app",
    embed = [":fixture_unassembled_lib"],
    tags = ["manual"],
    web = [],
)

embed_guard_test(
    name = "embed_unassembled_cache_test",
    target_under_test = ":fixture_unassembled_app.web",
)

test_suite(
    name = "analysis_tests",
    tests = [
        ":android_default_apk_test",
        ":android_offline_apk_test",
        ":android_online_apk_test",
        ":android_test_apk_test",
        ":android_toolchain_roots_test",
        ":build_command_customization_test",
        ":build_command_defaults_test",
        ":embed_unassembled_cache_test",
        ":linux_hermetic_toolchain_test",
    ],
)
