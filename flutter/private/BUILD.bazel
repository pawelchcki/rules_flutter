# Build-action helpers executed with the toolchain SDK's own `dart`, replacing
# host-language dependencies and normalizing Flutter's generated web output.
exports_files([
    "tools/pub_tool.dart",
    "tools/web_normalizer.dart",
    "tools/web_normalizer_test.dart",
])

filegroup(
    name = "pub_tool",
    srcs = ["tools/pub_tool.dart"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "web_normalizer",
    srcs = ["tools/web_normalizer.dart"],
    visibility = ["//visibility:public"],
)

