load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":dart_package_config.bzl", "dart_package_config")

# One package_config.json for the vendored protoc-gen-dart plugin repository,
# generated once per build and shared by every DartProtoCompile action (which
# previously each synthesized their own with an embedded Python interpreter).
dart_package_config(
    name = "protoc_gen_dart_package_config",
    package_files = "@pub_protoc_plugin//:protoc_plugin_files",
    pub_deps = "@pub_protoc_plugin//:pub_deps.json",
    visibility = ["//visibility:public"],
)

exports_files([
    "android.init.gradle.kts",
    "android_sdk_tree.bzl",
    "versions.bzl",
])

bzl_library(
    name = "android_sdk_tree",
    srcs = ["android_sdk_tree.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "android_repositories",
    srcs = ["android_repositories.bzl"],
    visibility = ["//visibility:public"],
)

# Upstream does not yet publish bzl_library wrappers for these public files;
# keep them in the stardoc dependency graph explicitly.
bzl_library(
    name = "hermetic_android_ndk_repositories",
    srcs = ["@hermetic_android_toolchains//ndk:repositories.bzl"],
    visibility = ["//flutter:__subpackages__"],
)

bzl_library(
    name = "hermetic_android_sdk_repositories",
    srcs = ["@hermetic_android_toolchains//sdk:repositories.bzl"],
    visibility = ["//flutter:__subpackages__"],
)

bzl_library(
    name = "hermetic_android_utils",
    srcs = ["@hermetic_android_toolchains//private:utils.bzl"],
    visibility = ["//flutter:__subpackages__"],
)

bzl_library(
    name = "pub_repository",
    srcs = ["pub_repository.bzl"],
    visibility = ["//flutter:__subpackages__"],
    deps = [":package_generation"],
)

bzl_library(
    name = "dart_package_config",
    srcs = ["dart_package_config.bzl"],
    visibility = ["//flutter:__subpackages__"],
)

bzl_library(
    name = "flutter_actions",
    srcs = ["flutter_actions.bzl"],
    visibility = ["//flutter:__subpackages__"],
)

bzl_library(
    name = "package_generation",
    srcs = ["package_generation.bzl"],
    visibility = ["//flutter:__subpackages__"],
)

bzl_library(
    name = "resolved_toolchain",
    srcs = ["resolved_toolchain.bzl"],
    visibility = ["//flutter:__subpackages__"],
)

bzl_library(
    name = "sdk_repo",
    srcs = ["sdk_repo.bzl"],
    visibility = ["//flutter:__subpackages__"],
)

bzl_library(
    name = "toolchains_repo",
    srcs = ["toolchains_repo.bzl"],
    visibility = ["//flutter:__subpackages__"],
)

bzl_library(
    name = "version_select",
    srcs = ["version_select.bzl"],
    visibility = ["//flutter:__subpackages__"],
)

bzl_library(
    name = "versions",
    srcs = ["versions.bzl"],
    visibility = ["//flutter:__subpackages__"],
)

# Build-action helper executed with the toolchain SDK's own `dart`, replacing
# the embedded Python the action scripts used to pipe into a host python3.
exports_files(["tools/pub_tool.dart"])

filegroup(
    name = "pub_tool",
    srcs = ["tools/pub_tool.dart"],
    visibility = ["//visibility:public"],
)
