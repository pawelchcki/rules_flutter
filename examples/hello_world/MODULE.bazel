"A minimal Flutter application built with rules_flutter."

bazel_dep(name = "rules_flutter", version = "0.2.0")

# Temporary until hermetic_android_toolchains publishes its first BCR release.
# Module overrides in rules_flutter do not propagate to this consumer module,
# so the standalone CI example must resolve the same patched archive itself.
# The patches directory is a symlink to the repository-root patches package.
bazel_dep(name = "hermetic_android_toolchains", version = "0.0.0")
archive_override(
    module_name = "hermetic_android_toolchains",
    integrity = "sha256-jovdpav966xUgaGTHIv5OMGtWxJMFk8ijbSoGQ6xX2E=",
    patch_strip = 1,
    patches = ["//patches:hermetic_android_toolchains_export_repositories.patch"],
    strip_prefix = "hermetic_android_toolchains-c6a9f203fbe1d4e72ecfc8d6ea47b81c844435ff",
    urls = ["https://github.com/keith/hermetic_android_toolchains/archive/c6a9f203fbe1d4e72ecfc8d6ea47b81c844435ff.tar.gz"],
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(
    flutter_version = "3.47.0",
    precache = ["web"],
)
use_repo(
    flutter,
    "flutter_sdk",
    "flutter_toolchains",
)

register_toolchains("@flutter_toolchains//:all")

# One hub repository per checked-in pubspec.lock, carrying that lock's whole
# hosted package closure. After editing pubspec.yaml, run
# `bazel run //:lib.update` to refresh the lock, then depend on the closure
# with `deps = ["@hello_world_deps//:all"]`. Flutter's SDK test package has
# hosted transitive dependencies, so the library consumes this hub as well.
pub = use_extension("@rules_flutter//flutter:extensions.bzl", "pub")
pub.lock(
    name = "hello_world_deps",
    file = "//:pubspec.lock",
)
use_repo(pub, "hello_world_deps", "pub_fixnum", "pub_meta", "pub_path", "pub_protobuf", "pub_protoc_plugin")
