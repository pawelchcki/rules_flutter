"A minimal Flutter application built with rules_flutter."

bazel_dep(name = "rules_flutter", version = "0.2.0")

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(
    flutter_version = "3.47.0",
    precache = ["web"],
)
use_repo(
    flutter,
    "flutter_sdk",
    "flutter_toolchains",
)

register_toolchains("@flutter_toolchains//:all")

# One hub repository per checked-in pubspec.lock, carrying that lock's whole
# hosted package closure. After editing pubspec.yaml, run
# `bazel run //:lib.update` to refresh the lock, then depend on the closure
# with `deps = ["@hello_world_deps//:all"]`. This app only uses SDK packages,
# so nothing references the hub yet.
pub = use_extension("@rules_flutter//flutter:extensions.bzl", "pub")
pub.lock(
    name = "hello_world_deps",
    file = "//:pubspec.lock",
)
use_repo(pub, "hello_world_deps", "pub_fixnum", "pub_meta", "pub_path", "pub_protobuf", "pub_protoc_plugin")
