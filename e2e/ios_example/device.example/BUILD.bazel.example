# Per-developer iOS signing configuration — NOT checked into version control.
#
# This whole `device/` directory is git-ignored so your Apple Team ID and
# provisioning profile never land in version control. It holds nothing but
# the credential: the device app itself is `//:app_device` in the root
# BUILD.bazel, which is the same `flutter_ios_app` as the simulator's
# `//:app` plus `provisioning_profile`.
#
# Setup (see README.md "Device builds" for the full walkthrough):
#   1. cp -r device.example device
#   2. mv device/BUILD.bazel.example device/BUILD.bazel
#   3. Obtain a development provisioning profile whose App ID is
#      com.rulesflutter.ios.example (or edit //:app_device's bundle_id to one
#      you control), installed into
#      ~/Library/Developer/Xcode/UserData/Provisioning Profiles/ — either
#      from the Apple Developer portal, or with `xcodebuild
#      -allowProvisioningUpdates` against any Xcode project whose
#      PRODUCT_BUNDLE_IDENTIFIER is that id. flutter_ios_app itself never
#      reads an Xcode project, so it need not be this repository's; see the
#      README. Free-team profiles expire after ~7 days — mint a fresh one
#      the same way.
#   4. Build:  bazel build //:app_device -c opt --ios_multi_cpus=arm64
#      Or run: flutter_bazel run -t //:app_device -d ios

load("@rules_apple//apple:apple.bzl", "local_provisioning_profile")

package(default_visibility = ["//visibility:public"])

local_provisioning_profile(
    name = "profile",
    profile_name = "iOS Team Provisioning Profile: com.rulesflutter.ios.example",
    tags = ["manual"],
)
