bazel_dep(name = "rules_flutter", version = "0.0.0", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.9.0", dev_dependency = True)

bazel_dep(name = "gazelle", version = "0.47.0", repo_name = "bazel_gazelle")
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_multirun", version = "0.13.0")

# Prebuilt protoc, used when building with
# --incompatible_enable_proto_toolchain_resolution: dart_proto_library must
# then generate through the resolved proto toolchain instead of the
# source-built @protobuf//:protoc (root-module registrations win over
# protobuf's own source toolchain).
bazel_dep(name = "toolchains_protoc", version = "0.6.1")

protoc = use_extension("@toolchains_protoc//protoc:extensions.bzl", "protoc")
protoc.toolchain(version = "v32.1")
use_repo(protoc, "toolchains_protoc_hub")

register_toolchains("@toolchains_protoc_hub//:all")

bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.4.1", dev_dependency = True)

local_path_override(
    module_name = "rules_flutter",
    path = "../..",
)

# Temporary until hermetic_android_toolchains publishes its first BCR release;
# keep this identical to the rules_flutter root override. `include()` cannot
# share the text: Bazel rejects that directive in a non-root module, so
# rules_flutter itself must spell the override inline. The patched *file* is
# deduped — e2e/smoke/patches is a symlink to the rules_flutter patches/
# directory, so both overrides name literally the same patch.
archive_override(
    module_name = "hermetic_android_toolchains",
    integrity = "sha256-jovdpav966xUgaGTHIv5OMGtWxJMFk8ijbSoGQ6xX2E=",
    patch_strip = 1,
    patches = ["//patches:hermetic_android_toolchains_export_repositories.patch"],
    strip_prefix = "hermetic_android_toolchains-c6a9f203fbe1d4e72ecfc8d6ea47b81c844435ff",
    urls = ["https://github.com/keith/hermetic_android_toolchains/archive/c6a9f203fbe1d4e72ecfc8d6ea47b81c844435ff.tar.gz"],
)

# The Gazelle plugin ships as its own module so plain rules_flutter consumers
# never resolve Go rules or a Go toolchain; this workspace tests both modules.
bazel_dep(name = "rules_flutter_gazelle", version = "0.0.0", dev_dependency = True)
local_path_override(
    module_name = "rules_flutter_gazelle",
    path = "../../gazelle",
)

# Without a root-module pin, Go SDK selection falls through to rules_android's
# go_sdk.download(version = "1.22.4"), whose darwin internal linker emits no
# LC_UUID load command — current macOS dyld refuses to start such binaries
# (the gazelle_binary dies with SIGABRT). Pin a modern SDK at the root, which
# always takes precedence.
bazel_dep(name = "rules_go", version = "0.59.0", dev_dependency = True)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.download(version = "1.25.0")

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(
    flutter_version = "3.24.0",
    # Verified at fetch time: sentinel artifacts must exist in the SDK cache
    # (stable archives ship them; `flutter precache` runs only if missing).
    precache = ["web"],
)
flutter.android_toolchain(
    name = "android",
    build_tools_version = "36.0.0",
    gradle_distribution_integrity = "sha256-1yXXB7+r1N/clYxiQAOzyArMwD9wN7USLEsdDvFc7Ks=",
    gradle_distribution_url = "https://services.gradle.org/distributions/gradle-8.9-bin.zip",
    sdk_version = "36",
)
flutter.linux_toolchain()
use_repo(
    flutter,
    "android_toolchains",
    "flutter_sdk",
    "flutter_toolchains",
    "linux_toolchains",
)

register_toolchains("@flutter_toolchains//:all")

register_toolchains("@android_toolchains//:all")

register_toolchains("@linux_toolchains//:all")

# Pub.dev dependencies
pub = use_extension("@rules_flutter//flutter:extensions.bzl", "pub")
pub.lock(
    name = "codegen_app_deps",
    file = "//codegen_app:pubspec.lock",
)
pub.lock(
    name = "dart_package_deps",
    file = "//dart_package:pubspec.lock",
)
pub.lock(
    name = "flutter_app_deps",
    file = "//flutter_app:pubspec.lock",
)

# gazelle_app has no BUILD file of its own (only BUILD.bazel.golden), so its
# lock is spelled relative to the root package.
pub.lock(
    name = "gazelle_app_deps",
    file = "//:gazelle_app/pubspec.lock",
)
use_repo(
    pub,
    "codegen_app_deps",
    "dart_package_deps",
    "flutter_app_deps",
    "gazelle_app_deps",
    "pub_fixnum",
    "pub_meta",
    "pub_path",
    "pub_protobuf",
    "pub_protoc_plugin",
)
