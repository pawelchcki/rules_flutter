load("@rules_flutter//flutter:defs.bzl", "flutter_library")

# Hosted pub dependencies come from the hub the pub extension generates for
# this package's pubspec.lock; the hub's name is chosen in MODULE.bazel, so
# gazelle has to be told it.
# gazelle:flutter_pub_hub gazelle_app_deps

flutter_library(
    name = "lib",
    srcs = ["lib/main.dart"],
    lock = "pubspec.lock",
    pubspec = "pubspec.yaml",
    deps = [
        "@flutter_sdk//flutter/packages/flutter",
        "@flutter_sdk//flutter/packages/flutter_test",
        "@gazelle_app_deps//:all",
    ],
)
