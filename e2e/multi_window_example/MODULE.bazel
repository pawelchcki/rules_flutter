"E2e test: multi-window (macOS) / multi-scene (iOS) Flutter app with FlutterEngineGroup"

module(name = "rules_flutter_multi_window_example")

bazel_dep(name = "rules_flutter", version = "0.0.0")
bazel_dep(name = "rules_dart", version = "0.4.9")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "apple_support", version = "2.5.4")
bazel_dep(name = "rules_apple", version = "4.5.3")
bazel_dep(name = "rules_cc", version = "0.2.19")
bazel_dep(name = "rules_swift", version = "3.6.1")
bazel_dep(name = "platforms", version = "1.1.0")

# Keep in sync with the root rules_dart override.
archive_override(
    module_name = "rules_dart",
    sha256 = "44b144bc5a4cce234160122a9f556a91c6b9a310bd262a3eacdc18625138b8ca",
    strip_prefix = "rules_dart-6cd2d1146614a6c982e492b2e558debf6f41d450",
    urls = ["https://github.com/aran/rules_dart/archive/6cd2d1146614a6c982e492b2e558debf6f41d450.tar.gz"],
)

local_path_override(
    module_name = "rules_flutter",
    path = "../..",
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.44.1")
flutter.pub(
    name = "deps",
    lock = "//:pubspec.lock",
)
use_repo(flutter, "deps", "flutter_ios_engine", "flutter_macos_engine", "flutter_toolchains")

register_toolchains("@flutter_toolchains//:all")
