load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_library", "dart_test")
load(":source_repo.bzl", "SOURCE_REPO")

exports_files(["pubspec.lock"])

_LIB_DEPS = [
    "@dev_tool_deps//:args",
    "@dev_tool_deps//:dds",
    "@dev_tool_deps//:dwds",
    "@dev_tool_deps//:logging",
    "@dev_tool_deps//:multicast_dns",
    "@dev_tool_deps//:package_config",
    "@dev_tool_deps//:path",
    "@dev_tool_deps//:pool",
    "@dev_tool_deps//:shelf",
    "@dev_tool_deps//:vm_service",
    "@dev_tool_deps//:watcher",
    "@rules_dart//dart/runfiles",
]

dart_library(
    name = "lib",
    package_name = "flutter_bazel_dev_tool",
    srcs = glob(["lib/**/*.dart"]),
    visibility = ["//visibility:private"],
    deps = _LIB_DEPS,
)

dart_binary(
    name = "flutter_bazel",
    srcs = glob(["lib/**/*.dart"]),
    compile_mode = "exe",
    # iOS device screenshots (pymobiledevice3) work from any host, so they are
    # always available. The desktop screen-capture helpers are local to their OS.
    data = [
        "//tools/ios_screenshot:screenshot",
        "//tools/ios_screenshot:tunneld",
        # DWDS injects this into the page and then serves it by reading its
        # own package source off disk via `Isolate.resolvePackageUri`, which
        # returns null in an AOT binary with no `.dart_tool/package_config.json`
        # above it — so DWDS threw and the browser got a `text/plain` 500.
        # Declared as a runtime input and served from runfiles instead.
        "@dev_tool_deps__dwds//:lib/src/injected/client.js",
    ] + select({
        "@platforms//os:macos": [
            "//tools/macos_screenshot:screenshot",
        ],
        "@platforms//os:windows": [
            "//tools/windows_screenshot:screenshot",
        ],
        "//conditions:default": [],
    }),
    defines = ["RUNFILES_SOURCE_REPO=" + SOURCE_REPO],
    main = "bin/flutter_bazel.dart",
    visibility = ["//visibility:public"],
    deps = _LIB_DEPS,
)

# Every unit test under test/. Adding an entry here is the whole cost of a new
# test file, and the list is the reason a file cannot quietly go unrun: the
# `/logs` endpoint's tests shipped without a target and so were never covered
# by `bazel test //...`, the canonical runner.
#
#   fakes — the test includes test/fakes.dart, which imports multicast_dns and
#           vm_service whatever the test itself imports.
#   deps  — packages the test imports directly, beyond :lib and test.
_TEST_DEPS = [
    ":lib",
    "@dev_tool_deps//:test",
]

_FAKES_DEPS = [
    "@dev_tool_deps//:multicast_dns",
    "@dev_tool_deps//:vm_service",
]

_PATH_DEP = ["@dev_tool_deps//:path"]

_UNIT_TESTS = {
    "agent_command_test": {},
    "app_instance_test": {"fakes": True},
    "app_log_sink_test": {"fakes": True},
    "app_log_test": {"fakes": True},
    "applied_versions_test": {"deps": _PATH_DEP},
    "attach_command_test": {},
    "bazel_test": {},
    "build_command_test": {},
    "cdp_console_test": {},
    "command_runner_test": {},
    "compiler_test": {"fakes": True},
    "device_integration_test": {"fakes": True},
    "dwds_injected_client_test": {"deps": ["@dev_tool_deps//:shelf"]},
    "device_test": {"fakes": True},
    "frontend_server_integration_test": {"fakes": True},
    "frontend_server_test": {"fakes": True},
    "host_tools_test": {"deps": _PATH_DEP},
    "http_control_channel_test": {},
    "machine_protocol_test": {"fakes": True},
    "mdns_vm_service_discovery_test": {"fakes": True},
    "native_libs_fingerprint_test": {},
    "package_uri_resolver_test": {"deps": _PATH_DEP},
    "readiness_gate_test": {},
    "reload_orchestrator_test": {
        "fakes": True,
        "deps": _PATH_DEP,
    },
    "run_command_lifecycle_test": {
        "fakes": True,
        "deps": _PATH_DEP,
    },
    "run_command_test": {},
    "session_test": {"fakes": True},
    "source_watcher_test": {"deps": ["@dev_tool_deps//:watcher"]},
    "toolchain_info_test": {"deps": _PATH_DEP},
    "vm_service_client_test": {"fakes": True},
    "vm_service_logs_test": {"fakes": True},
}

[dart_test(
    name = name,
    srcs = ["test/fakes.dart"] if cfg.get("fakes") else [],
    main = "test/%s.dart" % name,
    deps = _TEST_DEPS +
           (_FAKES_DEPS if cfg.get("fakes") else []) +
           cfg.get("deps", []),
) for name, cfg in _UNIT_TESTS.items()]
